library(readxl)
library(dplyr)
library(janitor)
library(ggplot2)
library(scales)
library(emmeans)
library(car)
tn_raw   <- read_excel("Total Nitrogen.xlsx") |> clean_names()
flux_raw <- read_excel("Flux.xlsx") |> clean_names()
frames   <- read_excel("Frames Volume.xlsx") |> clean_names()
tn_mean_by_type <- tn_raw |>
group_by(type) |>
summarise(
tn_mean_gN = mean(tn, na.rm = TRUE),
.groups = "drop"
)
frame_area_col <- grep(
"frame.*area",
names(frames),
ignore.case = TRUE,
value = TRUE
)[1]
frame_area_m2 <- frames |>
pull(all_of(frame_area_col))
frame_area_m2 <- frame_area_m2[!is.na(frame_area_m2)][1]
if (is.na(frame_area_m2)) {
stop("Frame area not found or equal to NA.")
}
frac_N_in_N2O <- 28 / 44
target_date <- as.Date("2026-01-19")
treatments_to_keep <- c(
"CSAA",
"CSH2SO4",
"CSRAW"
)
n2o_df <- flux_raw |>
filter(compound == "N2O") |>
mutate(date = suppressWarnings(as.Date(date))) |>
select(
id,
type,
chamber,
block,
date,
cum
) |>
filter(type %in% treatments_to_keep) |>
filter(date == target_date) |>
left_join(
tn_mean_by_type,
by = "type"
) |>
mutate(
n2o_g_per_frame = cum * frame_area_m2,
n2oN_g_per_frame = n2o_g_per_frame * frac_N_in_N2O,
n2oN_pct_of_tn = 100 * n2oN_g_per_frame / tn_mean_gN
) |>
filter(!is.na(n2oN_pct_of_tn)) |>
mutate(
type = factor(type),
chamber = factor(chamber),
block = factor(block)
)
# Check the number of observations in each block and treatment
cat("\nOBSERVATIONS PER BLOCK AND TREATMENT\n")
design_table <- with(
n2o_df,
table(block, type)
)
print(design_table)
mod <- lm(
n2oN_pct_of_tn ~ block + type,
data = n2o_df
)
# Complete model specification
cat("\nMODEL FORMULA\n")
print(formula(mod))
cat("\nNUMBER OF OBSERVATIONS\n")
print(nobs(mod))
cat("\nRESIDUAL DEGREES OF FREEDOM\n")
print(df.residual(mod))
# Sequential Type I ANOVA
cat("\nSEQUENTIAL TYPE I ANOVA\n")
anova_results <- anova(mod)
print(anova_results)
# Model coefficients
cat("\nMODEL SUMMARY\n")
print(summary(mod))
cat("\nSHAPIRO-WILK TEST ON MODEL RESIDUALS\n")
shapiro_results <- shapiro.test(
residuals(mod)
)
print(shapiro_results)
diagnostic_data <- data.frame(
residual = residuals(mod),
type = model.frame(mod)$type
)
cat("\nLEVENE TEST ON MODEL RESIDUALS\n")
levene_results <- leveneTest(
residual ~ type,
data = diagnostic_data,
center = median
)
print(levene_results)
# Diagnostic plots
par(mfrow = c(2, 2))
plot(mod)
par(mfrow = c(1, 1))
emm_type <- emmeans(
mod,
~ type
)
emm_results <- summary(
emm_type,
infer = c(TRUE, FALSE),
level = 0.95
)
cat("\nBLOCK-ADJUSTED ESTIMATED MARGINAL MEANS\n")
print(emm_results)
tukey_contrasts <- pairs(
emm_type,
adjust = "tukey"
)
contrast_results <- summary(
tukey_contrasts,
infer = c(TRUE, TRUE),
level = 0.95,
adjust = "tukey"
)
cat("\nTUKEY-ADJUSTED TREATMENT CONTRASTS\n")
print(contrast_results)
emm_df <- as.data.frame(emm_results)
p <- ggplot(
emm_df,
aes(x = type, y = emmean)
) +
geom_point(size = 3) +
geom_errorbar(
aes(
ymin = lower.CL,
ymax = upper.CL
),
width = 0.2
) +
theme_minimal(base_size = 12) +
labs(
x = "Treatment",
y = "N2O-N (% of TN)"
)
print(p)
View(emm_results)
View(anova_results)
View(tn_mean_by_type)
rm(list = ls())
setwd("/Users/lorenzobenedetti/Desktop/Università/DiANA/Dottorato/Danimarca/AU/Agroscena Next/DFC_SC_Lorenzo_Pablo/Static chambers")
